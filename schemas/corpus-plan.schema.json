{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ray-hola.invalid/git-composer/corpus-plan.schema.json",
  "title": "Git Composer offline corpus plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["plan_type", "schema_version", "mode", "network_enabled", "seed", "candidate_target", "target_meaning", "partitions", "manifest_schema", "constraints", "privacy"],
  "properties": {
    "plan_type": { "const": "corpus_sampling_plan" },
    "schema_version": { "const": 1 },
    "mode": { "enum": ["dry-run", "network"] },
    "network_enabled": { "type": "boolean" },
    "seed": { "type": "integer", "minimum": 0 },
    "candidate_target": { "type": "integer", "minimum": 1 },
    "target_meaning": { "type": "string", "minLength": 1 },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "share", "target_count", "qualifiers"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
          "share": { "type": "number", "minimum": 0, "maximum": 1 },
          "target_count": { "type": "integer", "minimum": 0 },
          "qualifiers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "manifest_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "record_type", "required_fields"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "record_type": { "const": "corpus_candidate" },
        "required_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "constraints": { "type": "object" },
    "privacy": { "type": "object" }
  }
}
